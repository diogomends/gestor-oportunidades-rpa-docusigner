{
  "name": "gestor-oportunidades-rpa-docusigner",
  "version": "1.0.0",
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "nodemon backend/src/server.js",
    "start:backend": "npm --prefix backend start",
    "dev:backend": "npm --prefix backend run dev",
    "test:backend": "npm --prefix backend test",
    "test:robot": "node --env-file=.env.dev --test \"tests/robot/**/*.test.js\"",
    "start:robot": "npm --prefix robot start",
    "build:robot": "npm --prefix robot run build",
    "test": "node --env-file=.env.dev --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "docusign-esign": "^9.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.6",
    "morgan": "^1.10.0",
    "playwright": "^1.47.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
