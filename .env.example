# Servidor (máquina local)
PORT=3111
NODE_ENV=development

# MongoDB REMOTO — mesmo banco do gestor-oportunidades na nuvem
MONGO_URI=mongodb://127.0.0.1:27017/db_crm_funil
MONGO_CONTRACTS_URI=mongodb://127.0.0.1:27017/crm_contracts

# JWT (mesmo secret do gestor para validar tokens de usuário e descriptografia)
JWT_SECRET=gestor_oportunidades_jwt_secret_key_change_me_in_prod

# DocuSign API (para o modo "api" do orchestrator)
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_RSA_PRIVATE_KEY_PATH=./key/private.key
DOCUSIGN_HMAC_KEY=
DOCUSIGN_BASE_PATH=na.docusign.net
DOCUSIGN_REDIRECT_URI=
DOCUSIGN_AUTH_BASE_URL=https://account.docusign.com/oauth/auth
DOCUSIGN_EMAIL_LINK_BASE_URL=

# Robot DocuSign (credenciais Playwright — fallback criptografado no DB)
USUARIO_DOCUSIGNER=
SENHA_DOCUSIGNER=
DOCUSIGN_SESSION_PATH=./session-docusign.json

# Integração com Gestor de Oportunidades
GESTOR_API_URL=http://localhost:3000/api
ROBOT_API_KEY=

